ht:700;font-size:18px;background:#ece6ff;padding:2px 8px;border-radius:2px}\n.steps li h4{margin:0 0 6px 0;font-size:16px;color:#1b1d23}\n.steps li p{margin:0;color:#3a3e4a;font-size:14px}\n\n/* FAQ details */\n.faqs{display:grid;gap:12px}\n.faqs details{background:#fff;border:1px dashed #b9bdd0;border-radius:2px;padding:0 20px;transition:border-color .2s}\n.faqs details[open]{border-color:#8a6df0;background:#fbfaff}\n.faqs summary{cursor:pointer;list-style:none;padding:16px 0;font-weight:600;color:#1b1d23;font-size:15px;position:relative;padding-right:36px}\n.faqs summary::-webkit-details-marker{display:none}\n.faqs summary::after{content:\"+\";position:absolute;right:4px;top:14px;font-size:20px;color:#6b3df5;font-weight:400;line-height:1}\n.faqs details[open] summary::after{content:\"−\"}\n.faqs details p{margin:0 0 16px 0;color:#3a3e4a;font-size:14px}\n\n/* 客户端/适配 */\n.clients{border:1px dashed #b9bdd0;background:#fff;padding:22px 26px;border-radius:2px;color:#3a3e4a}\n.clients ul{margin:8px 0 0 0;padding-left:20px}\n.clients ul li{margin:4px 0}\n\n/* 注意事项 */\n.notes{border-left:4px solid #a07bff;background:#faf7ff;padding:16px 20px;color:#3a3e4a;font-size:14px;border-radius:0 2px 2px 0}\n.notes strong{color:#1b1d23}\n\n/* 页脚 */\nfooter{padding:36px 0 56px 0;border-top:1px dashed #c5c8d6;margin-top:32px;color:#5b5f6e;font-size:13px}\nfooter .cols{display:flex;flex-wrap:wrap;gap:32px;justify-content:space-between}\nfooter ul{list-style:none;padding:0;margin:6px 0 0 0}\nfooter li{margin:4px 0}\nfooter h5{font-size:13px;color:#1b1d23;margin:0 0 6px 0;letter-spacing:.08em;text-transform:uppercase}\n\n@media (max-width:640px){\n  .band-3{height:56px}\n  .hero-inner{padding:36px 0 12px 0}\n  h1.brand{font-size:46px}\n  .ticket{padding:20px}\n  .ticket-head h3{font-size:19px}\n  .ticket-head .price{font-size:17px}\n  .jumpnav a{margin-bottom:6px}\n}\n</style><header class=\"hero\">\n  <span class=\"band band-1\"></span>\n  <span class=\"band band-2\"></span>\n  <span class=\"band band-3\"></span>\n  <div class=\"wrap hero-inner\">\n    <p class=\"eyebrow\">节点服务档位说明 · 清单式务实口吻</p>\n    <h1 class=\"brand\">雪云<em>档位清单</em></h1>\n    <p class=\"lede\">本页按月告知每一档雪云档位的流量、设备并发、节点带宽与工单通道，不夸大加速效果，也不替你做选择。请按下方清单逐项对照。</p>\n    <ul class=\"chips\">\n      <li>月度流量档</li>\n      <li>设备并发上限</li>\n      <li>节点与带宽</li>\n      <li>工单支持</li>\n    </ul>\n    <div class=\"jumpnav\">\n      <span>本页直达</span>\n      <a href=\"#plans\">档位价格</a>\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#compat\">适配平台</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n  <span class=\"band band-4\"></span>\n  <span class=\"band band-5\"></span>\n</header>\n\n<main class=\"wrap\">\n\n  <section id=\"plans\">\n    <h2><span class=\"num\">01</span>三档雪云档位</h2>\n    <p class=\"section-sub\">以下价格与权益直接来自本期档位清单，未在文中加入未提供的服务承诺。</p>\n\n    <article class=\"ticket\">\n      <div class=\"ticket-head\">\n        <h3>基础版</h3>\n        <div class=\"price\">¥15<small>/月</small></div>\n      </div>\n      <span class=\"annual\">按年付仅需 ¥150/年</span>\n      <ul>\n        <li>每月 100GB 极速流量</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>解锁基础流媒体</li>\n        <li>普通线路节点池</li>\n      </ul>\n    </article>\n\n    <article class=\"ticket featured\">\n      <div class=\"ticket-head\">\n        <h3>旗舰版<span class=\"tag\">推荐</span></h3>\n        <div class=\"price\">¥35<small>/月</small></div>\n      </div>\n      <span class=\"annual\">按年付仅需 ¥350/年</span>\n      <ul>\n        <li>每月 300GB 极速流量</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7x24 优先工单支持</li>\n      </ul>\n    </article>\n\n    <article class=\"ticket\">\n      <div class=\"ticket-head\">\n        <h3>团队版</h3>\n        <div class=\"price\">¥85<small>/月</small></div>\n      </div>\n      <span class=\"annual\">按年付仅需 ¥850/年</span>\n      <ul>\n        <li>每月 1000GB 极速流量</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n    </article>\n\n    <p class=\"notes\"><strong>价格说明：</strong>以上金额为本页档位清单中给出的价格，结算方式以购买时页面为准。</p>\n  </section>\n\n  <section id=\"usage\">\n    <h2><span class=\"num\">02</span>使用说明</h2>\n    <p class=\"section-sub\">按以下顺序完成即可,无需在阅读页面后再去翻阅其它文档。</p>\n    <ol class=\"steps\">\n      <li>\n        <h4>核对档位</h4>\n        <p>在上方三档中确认自己的月付/年付金额、流量额度与设备并发数。设备并发数指同时登录该档位的设备数。</p>\n      </li>\n      <li>\n        <h4>准备客户端</h4>\n        <p>适配平台见下一节。客户端的具体下载地址以购买邮件内附带的链接为准,本文不直接提供第三方下载链接。</p>\n      </li>\n      <li>\n        <h4>导入订阅</h4>\n        <p>登录后在用户中心复制订阅链接,粘贴到客户端的订阅地址栏,完成节点列表更新。</p>\n      </li>\n      <li>\n        <h4>选择节点</h4>\n        <p>根据当下用途选择节点类型。基础版为普通线路节点池;旗舰版增加 IPLC 专线;团队版为 VIP 专属高带宽节点。</p>\n      </li>\n      <li>\n        <h4>关注流量</h4>\n        <p>每月 100GB / 300GB / 1000GB 为各档位额度上限,优先工单与专属经理服务是工单层面的差别,不会改变流量计数方式。</p>\n      </li>\n    </ol>\n  </section>\n\n  <section id=\"compat\">\n    <h2><span class=\"num\">03</span>适配平台</h2>\n    <p class=\"section-sub\">以下为常见的客户端适配范围,具体可用版本请以购买后下发的客户端列表为准。</p>\n    <div class=\"clients\">\n      <strong>覆盖范围</strong>\n      <ul>\n        <li>iOS / iPadOS</li>\n        <li>Android</li>\n        <li>macOS</li>\n        <li>Windows</li>\n        <li>Linux(命令行与图形客户端)</li>\n        <li>路由器固件(OpenWrt 等)</li>\n      </ul>\n    </div>\n    <p class=\"notes\"><strong>提示：</strong>本页未列出特定客户端的下载地址与版本号,请以购买后收到的邮件或用户中心为准。</p>\n  </section>\n\n  <section id=\"faq\">\n    <h2><span class=\"num\">04</span>常见问题</h2>\n    <p class=\"section-sub\">点击问题展开答案。如需更进一步的细节,请通过工单提交。</p>\n    <div class=\"faqs\">\n\n      <details>\n        <summary>三档位之间最明显的差别是什么?</summary>\n        <p>最明显的差别在每月流量额度与设备并发数。基础版 100GB/3 台,旗舰版 300GB/5 台,团队版 1000GB/20 台。除此之外,节点类型与工单通道按档位递增,普通线路节点池、IPLC 专线、VIP 专属高带宽节点分别对应基础版、旗舰版、团队版。</p>\n      </details>\n\n      <details>\n        <summary>按月付和按年付分别怎么计费?</summary>\n        <p>按月付为每月支付基础版 ¥15、旗舰版 ¥35、团队版 ¥85。按年付的总价分别为 ¥150、¥350、¥850,折合到每月与月付价格一致。具体结算方式以购买时页面为准。</p>\n      </details>\n\n      <details>\n        <summary>设备并发数指的是什么?</summary>\n        <p>指同一档位账号下,允许同时在线的最大设备数量。例如基础版最多 3 台设备同时在线,超出后再登录新设备会挤掉最早登录的会话。</p>\n      </details>\n\n      <details>\n        <summary>旗舰版的 IPLC 专线用于哪种场景?</summary>\n        <p>本页档位清单描述为\"IPLC 专线游戏加速优化\",即针对游戏的低延迟与稳定连接做了优化。其他用途(例如视频、办公、下载)同样可使用,只是该档位额外给出了游戏加速这条线路标签。</p>\n      </details>\n\n      <details>\n        <summary>团队版与基础版、旗舰版的主要差异?</summary>\n        <p>团队版的差异集中在三点:一是流量提升到每月 1000GB;二是设备并发数提升到 20 台;三是提供 VIP 专属高带宽节点、支持企业定制路由与专属客户经理服务,适合多人共用或企业场景。</p>\n      </details>\n\n      <details>\n        <summary>在哪里获取客户端?</summary>\n        <p>本页不直接列出客户端下载地址。客户端的具体链接会在你下单完成后通过邮件发送,也可在用户中心查看。请不要从未经验证的第三方渠道下载。</p>\n      </details>\n\n      <details>\n        <summary>工单支持与专属客户经理的区别?</summary>\n        <p>工单支持按档位不同而不同,旗舰版提供 7x24 优先工单支持;团队版进一步提供专属客户经理服务。基础版工单通道为普通处理流程,响应时长随队列情况而定。</p>\n      </details>\n\n      <details>\n        <summary>如果当月流量用完会怎样?</summary>\n        <p>本页档位清单仅给出每月额度,未对超出额度后的具体行为(限速、停服或按量计费)做出说明。建议在流量使用接近上限前,通过工单询问后续规则。</p>\n      </details>\n\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"wrap\">\n  <div class=\"cols\">\n    <div>\n      <h5>雪云 · 档位清单</h5>\n      <p>本页为雪云档位与使用说明的静态清单,所有金额、流量与设备并发数均直接来自档位条目。</p>\n    </div>\n    <div>\n      <h5>区块直达</h5>\n      <ul>\n        <li><a href=\"#plans\">档位价格</a></li>\n        <li><a href=\"#usage\">使用说明</a></li>\n        <li><a href=\"#compat\">适配平台</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </div>\n    <div>\n      <h5>说明</h5>\n      <ul>\n        <li>本页不列出客户端下载链接</li>\n        <li>本页未给出加速效果承诺</li>\n        <li>结算方式以购买页面为准</li>\n      </ul>\n    </div>\n  </div>\n</footer>",
